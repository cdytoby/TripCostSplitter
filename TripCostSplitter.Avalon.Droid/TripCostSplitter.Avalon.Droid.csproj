<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0-android</TargetFramework>
    <OutputType>Exe</OutputType>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <SupportedOSPlatformVersion>23.0</SupportedOSPlatformVersion>
    <ApplicationId>com.TripCostSplitter.Avalon</ApplicationId>
    <ApplicationDisplayProperty>TripCostSplitter</ApplicationDisplayProperty>
    <ApplicationVersion>1</ApplicationVersion>
    <AndroidUseIntermediateDesignerFile>True</AndroidUseIntermediateDesignerFile>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia" Version="12.0.4" />
    <PackageReference Include="Avalonia.Android" Version="12.0.4" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\TripCostSplitter.Avalon\TripCostSplitter.Avalon.csproj" />
  </ItemGroup>
</Project>