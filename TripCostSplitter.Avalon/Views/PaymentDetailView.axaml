<ContentPage
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:vm="clr-namespace:TripCostSplitter.AppBase.ViewModels;assembly=TripCostSplitter.AppBase"
    xmlns:splitViewModels="clr-namespace:TripCostSplitter.AppBase.ViewModels.SplitViewModels;assembly=TripCostSplitter.AppBase"
    xmlns:splitViews="clr-namespace:TripCostSplitter.Avalon.Views.SplitViews"
    xmlns:dataModels="clr-namespace:TripCostSplitter.Core.DataModels;assembly=TripCostSplitter.Core"
    xmlns:converters="clr-namespace:TripCostSplitter.Avalon.Converters"
    xmlns:designViewModels="clr-namespace:TripCostSplitter.Avalon.DesignViewModels"
    xmlns:views="clr-namespace:TripCostSplitter.Avalon.Views"
    x:Class="TripCostSplitter.Avalon.Views.PaymentDetailView"
    x:DataType="vm:PaymentDetailViewModel"
    x:Name="PaymentDetailPage"
    d:DesignWidth="400"
    d:DesignHeight="800"
    d:DataContext="{x:Static designViewModels:DesignData.PaymentDetailViewModelDesign}"
    NavigationPage.TopCommandBar="{StaticResource TopBar}"
    NavigationPage.Header="{Binding Transaction.Description}">

    <ContentPage.Styles>
        <StyleInclude
            Source="avares://TripCostSplitter.Avalon/Resources/AppStyles.axaml" />
    </ContentPage.Styles>

    <ContentPage.Resources>
        <!-- ReSharper disable Xaml.RedundantResource -->
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceInclude
                    Source="/Resources/AppResources.axaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
        <CommandBar
            x:Key="TopBar"
            DataContext="{Binding #PaymentDetailPage.((vm:PaymentDetailViewModel)DataContext)}">
            <CommandBar.PrimaryCommands>
                <CommandBarButton
                    Label="Cancel"
                    Command="{Binding CancelCommand}">
                    <CommandBarButton.Icon>
                        <PathIcon
                            Data="{StaticResource IconRejectRegular}" />
                    </CommandBarButton.Icon>
                </CommandBarButton>
                <CommandBarButton
                    Label="Save"
                    Command="{Binding SaveCommand}">
                    <CommandBarButton.Icon>
                        <PathIcon
                            Data="{StaticResource IconSaveRegular}" />
                    </CommandBarButton.Icon>
                </CommandBarButton>
            </CommandBar.PrimaryCommands>
        </CommandBar>
        <!-- ReSharper restore Xaml.RedundantResource -->
        <converters:PersonIdNameConverter
            x:Key="PersonIdNameConverter" />
        <converters:CurrencyInputConverterConverter
            x:Key="CurrencyInputConverterConverter" />
    </ContentPage.Resources>

    <ScrollViewer
        Padding="10,10,16,10">
        <StackPanel
            Spacing="10"
            Margin="0,0,0,10">
            <TextBox
                Text="{Binding Transaction.Description, FallbackValue=''}"
                PlaceholderText="Description" />
            <Grid
                ColumnDefinitions="Auto,*,*"
                RowDefinitions="Auto,Auto"
                RowSpacing="10">
                <TextBlock
                    Grid.Row="0"
                    Grid.Column="0"
                    Classes="h3"
                    VerticalAlignment="Center"
                    Margin="0,0,5,0"
                    Text="Date time" />
                <CalendarDatePicker
                    Grid.Row="0"
                    Grid.Column="1"
                    Margin="0,0,5,0"
                    HorizontalAlignment="Stretch"
                    SelectedDate="{Binding Date}" />
                <TimePicker
                    Grid.Row="0"
                    Grid.Column="2"
                    Margin="5,0,0,0"
                    HorizontalAlignment="Stretch"
                    MinWidth="0"
                    SelectedTime="{Binding Time}"
                    ClockIdentifier="24HourClock" />
                <TextBlock
                    Grid.Row="1"
                    Grid.Column="0"
                    Classes="h3"
                    VerticalAlignment="Center"
                    Margin="0,0,5,0"
                    Text="Currency" />
                <ComboBox
                    Grid.Row="1"
                    Grid.Column="1"
                    Grid.ColumnSpan="2"
                    HorizontalAlignment="Stretch"
                    ItemsSource="{Binding AvailableCurrencies}"
                    SelectedValue="{Binding Currency}"
                    ItemTemplate="{StaticResource CurrencyComboBoxTemplate}" />
            </Grid>

            <!-- Who Paid -->
            <Separator
                Margin="0,20,0,0" />
            <Grid
                ColumnDefinitions="*,Auto">
                <TextBlock
                    Classes="h3"
                    VerticalAlignment="Center"
                    Text="Who Paid?" />
                <Button
                    Grid.Column="1"
                    Name="AddPayerButton"
                    Classes="actionIcon"
                    Content="+">
                    <Button.Flyout>
                        <MenuFlyout
                            ItemsSource="{Binding TravelParticipants}">
                            <MenuFlyout.ItemTemplate>
                                <DataTemplate
                                    DataType="dataModels:Person">
                                    <MenuItem
                                        Header="{Binding Name}"
                                        Command="{Binding #AddPayerButton.((vm:PaymentDetailViewModel)DataContext).AddPayerCommand}"
                                        CommandParameter="{Binding}" />
                                </DataTemplate>
                            </MenuFlyout.ItemTemplate>
                        </MenuFlyout>
                    </Button.Flyout>
                </Button>
            </Grid>
            <ItemsControl
                ItemsSource="{Binding PaymentData.PayerInfos}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Grid
                            ColumnDefinitions="*,3*,Auto"
                            ColumnSpacing="10"
                            Margin="0,2">
                            <TextBlock
                                Grid.Column="0"
                                HorizontalAlignment="Right"
                                VerticalAlignment="Center">
                                <TextBlock.Text>
                                    <MultiBinding
                                        Converter="{StaticResource PersonIdNameConverter}">
                                        <Binding
                                            Path="PayerId" />
                                        <Binding
                                            Path="$parent[ContentPage].((vm:PaymentDetailViewModel)DataContext).TravelParticipants" />
                                    </MultiBinding>
                                </TextBlock.Text>
                            </TextBlock>
                            <NumericUpDown
                                Grid.Column="1"
                                Classes="default"
                                Value="{ReflectionBinding Amount, FallbackValue=0, TargetNullValue=0}"
                                TextConverter="{Binding 
                                    $parent[ContentPage].((vm:PaymentDetailViewModel)DataContext).Currency,
                                    Converter={StaticResource CurrencyInputConverterConverter}}"
                                PlaceholderText="Amount"
                                LostFocus="PaymentPriceInputElement_OnLostFocus" />
                            <Button
                                Grid.Column="2"
                                Classes="actionIcon"
                                Content="-"
                                Command="{Binding $parent[ContentPage].((vm:PaymentDetailViewModel)DataContext).RemovePayerCommand}"
                                CommandParameter="{Binding}" />
                        </Grid>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <!-- Cost Breakdown -->
            <Separator
                Margin="0,20,0,0" />
            <Grid
                ColumnDefinitions="Auto,Auto,*,Auto"
                ColumnSpacing="10">
                <TextBlock
                    Grid.Column="0"
                    HorizontalAlignment="Left"
                    VerticalAlignment="Center"
                    Classes="h3"
                    Text="Cost Breakdown" />
                <CheckBox
                    Grid.Column="1"
                    HorizontalAlignment="Left"
                    IsChecked="{Binding EnableItemList}" />
                <TextBlock
                    Grid.Column="2"
                    Classes="error"
                    VerticalAlignment="Center"
                    IsVisible="{Binding HasPurchaseItemValidationError}"
                    Text="!" />
                <Button
                    Grid.Column="3"
                    Classes="actionIcon"
                    Content="+"
                    IsEnabled="{Binding EnableItemList}"
                    Command="{Binding AddPurchaseItemCommand}"
                    VerticalAlignment="Center" />
            </Grid>
            <ItemsControl
                ItemsSource="{Binding PaymentData.PurchaseItems}"
                IsEnabled="{Binding EnableItemList}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Grid
                            ColumnDefinitions="*,110,Auto,Auto"
                            ColumnSpacing="10"
                            Margin="0,2">
                            <TextBox
                                Grid.Column="0"
                                Text="{Binding ItemName}"
                                PlaceholderText="Item Name"
                                LostFocus="PurchaseItemInputElement_OnLostFocus" />
                            <NumericUpDown
                                Grid.Column="1"
                                Classes="default"
                                Value="{Binding Price, FallbackValue=0, TargetNullValue=0}"
                                TextConverter="{Binding 
                                    $parent[ContentPage].((vm:PaymentDetailViewModel)DataContext).Currency,
                                    Converter={StaticResource CurrencyInputConverterConverter}}"
                                PlaceholderText="Price"
                                LostFocus="PurchaseItemPriceInputElement_OnLostFocus" />
                            <Button
                                Grid.Column="2"
                                Classes="actionIcon"
                                Command="{Binding $parent[ContentPage].((vm:PaymentDetailViewModel)DataContext).DuplicatePurchaseItemCommand}"
                                CommandParameter="{Binding}">
                                <PathIcon
                                    Data="{StaticResource IconCopyRegular}" />
                            </Button>
                            <Button
                                Grid.Column="3"
                                Classes="actionIcon"
                                Content="-"
                                Command="{Binding $parent[ContentPage].((vm:PaymentDetailViewModel)DataContext).RemovePurchaseItemCommand}"
                                CommandParameter="{Binding}" />
                        </Grid>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <Separator
                Margin="0,20,0,0" />

            <Grid
                ColumnDefinitions="Auto,*"
                ColumnSpacing="10">
                <TextBlock
                    Grid.Column="0"
                    Classes="h3"
                    VerticalAlignment="Center"
                    Text="Split Method" />
                <ComboBox
                    Grid.Column="1"
                    HorizontalAlignment="Stretch"
                    ItemsSource="{Binding AvailableSplitMethods, Mode=OneWay}"
                    SelectedItem="{Binding CurrentSplitMethod}" />
            </Grid>

            <ContentControl
                Padding="0,0,2,40"
                Content="{Binding SplitDataViewModel}">
                <ContentControl.DataTemplates>
                    <DataTemplate
                        DataType="splitViewModels:SplitByPercentageViewModel">
                        <splitViews:SplitByPercentageView />
                    </DataTemplate>
                    <DataTemplate
                        DataType="splitViewModels:SplitByItemOwnershipViewModel">
                        <splitViews:SplitByItemOwnershipView />
                    </DataTemplate>
                    <DataTemplate
                        DataType="splitViewModels:SplitByExactAmountViewModel">
                        <splitViews:SplitByExactAmountView />
                    </DataTemplate>
                </ContentControl.DataTemplates>
            </ContentControl>
        </StackPanel>
    </ScrollViewer>
</ContentPage>