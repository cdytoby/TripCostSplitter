<ContentPage
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:vm="clr-namespace:TripCostSplitter.AppBase.ViewModels;assembly=TripCostSplitter.AppBase"
    xmlns:splitViewModels="clr-namespace:TripCostSplitter.AppBase.ViewModels.SplitViewModels;assembly=TripCostSplitter.AppBase"
    xmlns:splitViews="clr-namespace:TripCostSplitter.Avalon.Views.SplitViews"
    xmlns:dataModels="clr-namespace:TripCostSplitter.Core.DataModels;assembly=TripCostSplitter.Core"
    xmlns:converters="clr-namespace:TripCostSplitter.Avalon.Converters"
    x:Class="TripCostSplitter.Avalon.Views.PaymentDetailView"
    x:CompileBindings="False"
    d:DesignWidth="400"
    d:DesignHeight="800"
    DataContext="{Binding RelativeSource={RelativeSource Self}, Path=ViewModel}"
    Header="Transaction Details">

    <ContentPage.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceInclude
                    Source="/Resources/AppResources.axaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
        <converters:PersonIdNameConverter
            x:Key="PersonIdNameConverter" />
    </ContentPage.Resources>

    <DockPanel
        Margin="10">
        <StackPanel
            DockPanel.Dock="Bottom"
            Orientation="Horizontal"
            Spacing="10"
            HorizontalAlignment="Right"
            Margin="0,10,0,0">
            <Button
                Content="Cancel"
                Command="{Binding CancelCommand}" />
            <Button
                Content="Save"
                Command="{Binding SaveCommand}" />
        </StackPanel>

        <ScrollViewer
            Padding="0,0,16,0">
            <StackPanel
                Spacing="10"
                Margin="0,0,0,10">
                <TextBox
                    Text="{Binding PaymentData.Description, FallbackValue=''}"
                    PlaceholderText="Description" />
                <Grid
                    ColumnDefinitions="*,*">
                    <CalendarDatePicker
                        Grid.Column="0"
                        Margin="0,0,5,0"
                        HorizontalAlignment="Stretch"
                        SelectedDate="{Binding Date}" />
                    <TimePicker
                        Grid.Column="1"
                        Margin="5,0,0,0"
                        HorizontalAlignment="Stretch"
                        MinWidth="0"
                        SelectedTime="{Binding Time}"
                        ClockIdentifier="24HourClock" />
                </Grid>
                <ComboBox
                    ItemsSource="{Binding AvailableCurrencies}"
                    SelectedValue="{Binding PaymentData.Currency, FallbackValue=''}"
                    SelectedValueBinding="{Binding Path=Code}"
                    ItemTemplate="{StaticResource CurrencyComboBoxTemplate}">
                </ComboBox>

                <!-- Who Paid -->
                <Separator />
                <Grid
                    ColumnDefinitions="*,Auto">
                    <TextBlock
                        VerticalAlignment="Center"
                        Text="Who Paid?"
                        FontWeight="Bold"
                        FontSize="18" />
                    <Button
                        Name="AddPayerButton"
                        Grid.Column="1"
                        Content="+">
                        <Button.Flyout>
                            <MenuFlyout
                                ItemsSource="{Binding TravelParticipants}">
                                <MenuFlyout.ItemTemplate>
                                    <DataTemplate
                                        DataType="dataModels:Person">
                                        <MenuItem
                                            Header="{Binding Name}"
                                            Command="{Binding #AddPayerButton.((vm:PaymentDetailViewModel)DataContext).AddPayerCommand}"
                                            CommandParameter="{Binding}" />
                                    </DataTemplate>
                                </MenuFlyout.ItemTemplate>
                            </MenuFlyout>
                        </Button.Flyout>
                    </Button>
                </Grid>
                <ItemsControl
                    ItemsSource="{Binding PaymentData.PayerInfos}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Grid
                                ColumnDefinitions="*,100,Auto"
                                Margin="0,2">
                                <TextBlock
                                    Grid.Column="0"
                                    VerticalAlignment="Center">
                                    <TextBlock.Text>
                                        <MultiBinding
                                            Converter="{StaticResource PersonIdNameConverter}">
                                            <Binding
                                                Path="PayerId" />
                                            <Binding
                                                Path="$parent[ContentPage].((vm:PaymentDetailViewModel)DataContext).TravelParticipants" />
                                        </MultiBinding>
                                    </TextBlock.Text>
                                </TextBlock>
                                <TextBox
                                    Grid.Column="1"
                                    Text="{Binding Amount, TargetNullValue=''}"
                                    PlaceholderText="Amount" />
                                <Button
                                    Grid.Column="2"
                                    Content="-"
                                    Command="{Binding $parent[ContentPage].((vm:PaymentDetailViewModel)DataContext).RemovePayerCommand}"
                                    CommandParameter="{Binding}" />
                            </Grid>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <!-- Cost Breakdown -->
                <Separator />
                <Grid
                    ColumnDefinitions="*,Auto">
                    <TextBlock
                        VerticalAlignment="Center"
                        Text="Cost Breakdown"
                        FontWeight="Bold"
                        FontSize="18" />
                    <Button
                        Grid.Column="1"
                        Content="+"
                        Command="{Binding AddPurchaseItemCommand}"
                        VerticalAlignment="Center" />
                </Grid>
                <ItemsControl
                    ItemsSource="{Binding PaymentData.PurchaseItems}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Grid
                                ColumnDefinitions="*,100,Auto"
                                Margin="0,2">
                                <TextBox
                                    Grid.Column="0"
                                    Text="{Binding Item}"
                                    PlaceholderText="Item Name" />
                                <TextBox
                                    Grid.Column="1"
                                    Text="{Binding Price, TargetNullValue=''}"
                                    PlaceholderText="Price"
                                    Margin="5,0" />
                                <Button
                                    Grid.Column="2"
                                    Content="-"
                                    Command="{Binding $parent[ContentPage].((vm:PaymentDetailViewModel)DataContext).RemovePurchaseItemCommand}"
                                    CommandParameter="{Binding}" />
                            </Grid>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <Separator />

                <StackPanel
                    Orientation="Horizontal"
                    Spacing="20">
                    <TextBlock
                        VerticalAlignment="Center"
                        Text="Split Method"
                        FontWeight="Bold"
                        FontSize="18" />
                    <ComboBox
                        MinWidth="100"
                        ItemsSource="{Binding AvailableSplitMethods, Mode=OneWay}"
                        SelectedItem="{Binding CurrentSplitMethod}" />
                </StackPanel>

                <TextBlock
                    Text="Split Details"
                    FontWeight="SemiBold" />

                <ContentControl
                    MinHeight="250"
                    Content="{Binding SplitDataViewModel}">
                    <ContentControl.DataTemplates>
                        <DataTemplate
                            DataType="splitViewModels:SplitByPercentageViewModel">
                            <splitViews:SplitByPercentageView />
                        </DataTemplate>
                        <DataTemplate
                            DataType="splitViewModels:SplitByItemOwnershipViewModel">
                            <splitViews:SplitByItemOwnershipView />
                        </DataTemplate>
                        <DataTemplate
                            DataType="splitViewModels:SplitByExactAmountViewModel">
                            <splitViews:SplitByExactAmountView />
                        </DataTemplate>
                    </ContentControl.DataTemplates>
                </ContentControl>
            </StackPanel>
        </ScrollViewer>

    </DockPanel>
</ContentPage>