<ContentPage
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:vm="clr-namespace:TripCostSplitter.AppBase.ViewModels;assembly=TripCostSplitter.AppBase"
    xmlns:dvms="clr-namespace:TripCostSplitter.Avalon.DesignViewModels;assembly=TripCostSplitter.Avalon"
    mc:Ignorable="d"
    x:Name="TravelListPage"
    x:Class="TripCostSplitter.Avalon.Views.TravelListView"
    x:DataType="vm:TravelListViewModel"
    d:DesignWidth="400"
    d:DesignHeight="800"
    d:DataContext="{x:Static dvms:DesignData.TravelListViewModelDesign}"
    Header="Travels"
    NavigationPage.TopCommandBar="{StaticResource TopBar}">

    <ContentPage.Styles>
        <StyleInclude
            Source="avares://TripCostSplitter.Avalon/Resources/AppStyles.axaml" />
    </ContentPage.Styles>

    <ContentPage.Resources>
        <!-- ReSharper disable Xaml.RedundantResource -->
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceInclude
                    Source="/Resources/AppResources.axaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
        <!-- ReSharper restore Xaml.RedundantResource -->
        <CommandBar
            x:Key="TopBar"
            DataContext="{Binding #TravelListPage.((vm:TravelListViewModel)DataContext)}">
            <CommandBar.PrimaryCommands>
                <CommandBarButton
                    Label="Travel"
                    Command="{Binding AddTravelCommand}">
                    <CommandBarButton.Icon>
                        <PathIcon
                            Data="{StaticResource IconAddRegular}" />
                    </CommandBarButton.Icon>
                </CommandBarButton>
                <CommandBarButton
                    Label="Settings"
                    Command="{Binding NavigateToSettingsCommand}">
                    <CommandBarButton.Icon>
                        <PathIcon
                            Data="{StaticResource IconSettingsRegular}" />
                    </CommandBarButton.Icon>
                </CommandBarButton>
            </CommandBar.PrimaryCommands>
        </CommandBar>
    </ContentPage.Resources>

    <ListBox
        ItemsSource="{Binding Travels}"
        SelectionMode="Single">
        <ListBox.Styles>
            <Style
                Selector="ListBoxItem">
                <Setter
                    Property="Margin"
                    Value="0" />
                <Setter
                    Property="Padding"
                    Value="0" />
            </Style>
        </ListBox.Styles>
        <ListBox.ItemTemplate>
            <DataTemplate>
                <Button
                    Background="Transparent"
                    HorizontalAlignment="Stretch"
                    VerticalAlignment="Stretch"
                    Padding="15"
                    Command="{Binding $parent[ListBox].((vm:TravelListViewModel)DataContext).EditTravelCommand}"
                    CommandParameter="{Binding}">
                    <Grid
                        ColumnDefinitions="*,Auto">
                        <StackPanel
                            Grid.Column="0"
                            VerticalAlignment="Center">
                            <StackPanel
                                Orientation="Horizontal"
                                Spacing="10">
                                <TextBlock
                                    Classes="h3"
                                    Margin="0,0,5,0"
                                    Text="{Binding Name}" />
                                <TextBlock
                                    Classes="sub"
                                    VerticalAlignment="Center"
                                    Text="{Binding CalculateCurrency}" />
                                <ItemsControl
                                    ItemsSource="{Binding AdditionalCurrencies}"
                                    VerticalAlignment="Center"
                                    Foreground="Gray">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <WrapPanel
                                                Orientation="Horizontal" 
                                                ItemSpacing="10"/>
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                </ItemsControl>
                            </StackPanel>
                            <ItemsControl
                                ItemsSource="{Binding Participants}"
                                DisplayMemberBinding="{Binding Name}"
                                Foreground="Gray">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <WrapPanel
                                            Orientation="Horizontal" 
                                            ItemSpacing="10"/>
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                            </ItemsControl>
                        </StackPanel>
                        <Button
                            Grid.Column="1"
                            Classes="actionIcon"
                            Command="{Binding $parent[ListBox].((vm:TravelListViewModel)DataContext).DeleteTravelCommand}"
                            CommandParameter="{Binding}">
                            <PathIcon
                                Data="{StaticResource IconDeleteRegular}" />
                        </Button>
                    </Grid>
                </Button>
            </DataTemplate>
        </ListBox.ItemTemplate>
    </ListBox>
</ContentPage>